# Screenshots of the example apps for docs/app-development.md.
# Run from the repository root (aarch64 Linux host):
#   cargo sim --script docs/screenshots/examples.sim
# Weather answers come from fixtures in sim/fixtures/examples/, not the
# network, so the pictures do not change from run to run.
mock api.open-meteo.com/v1/forecast?latitude=51.51 sim/fixtures/examples/weather-london.json
mock api.open-meteo.com/v1/forecast?latitude=21.03 sim/fixtures/examples/weather-unavailable.json 503
# The Examples page is the last home screen page: swipe left twice.
swipe 400 400 80 400 150
wait 400
swipe 400 400 80 400 150
wait 400
shot docs/screenshots/example-page.png
# Hello Counter: tap +1 three times.
launch example-hello
tap 388 676
tap 388 676
tap 388 676
shot docs/screenshots/example-hello.png
# Lap Timer: Start, three laps, Stop.
launch example-laps
tap 354 320
wait 1300
tap 126 320
wait 900
tap 126 320
wait 1500
tap 126 320
tap 354 320
shot docs/screenshots/example-laps.png
# Weather: London, then Hanoi, whose fixture is an HTTP 503 error.
launch example-weather
wait 500
shot docs/screenshots/example-weather.png
tap 353 144
wait 500
shot docs/screenshots/example-weather-error.png
# Back to London, in landscape.
tap 127 144
wait 500
rotate
wait 300
shot docs/screenshots/example-weather-landscape.png
